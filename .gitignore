# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Never commit env files at any depth — a src/.env slipped past
# *.local once and leaked an OpenAI key to public GitHub. Both
# patterns block bare .env and any .env.<suffix> at every folder.
.env
.env.*
**/.env
**/.env.*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.claude/worktrees/

# Image-tool backups (rotate / compress scripts write these next
# to the file being modified so a wrong-direction rotation or
# too-aggressive compression is reversible locally). Not for the
# repo — restore by renaming, or delete when confirmed happy.
*.original.webp
*.original.jpg
*.original.jpeg
*.original.png
*.bak

# Local Netlify folder
.netlify

# Local-only files (not part of the site)
# deno.lock — auto-created by Netlify's local edge-function tooling
deno.lock
# Original full-size photos; the site uses compressed .webp copies in public/
src/assets/dinner exp/
src/assets/newest products/

# Generated by scripts/build-community.cjs from the sibling .jsx (Academy P0.5)
public/community/spore/*.js
public/community/myco/agent.js
public/community/admin/kanban.js
!public/community/myco/prompts.js
!public/community/myco/context.js
!public/community/dm/crypto.js

# React islands for static pages, bundled by scripts/build-islands.cjs
public/islands/

# Atlas dataset, generated from herbs.ts by scripts/build-atlas.cjs
public/atlas/data/

# Generated herb monographs — rendered from herbs.ts by
# scripts/build-herb-monographs.cjs. Regenerate, do not commit: committing
# them would duplicate herbs.ts in a second format that can drift.
public/home/markdowns all plants/generated/

# NOTE: public/atlas/ media is tracked normally. An earlier attempt to ignore
# unused stills here meant an image could be used on the page, work locally,
# and silently not deploy. Atlas art is small and belongs in the repo; if a
# large unused clip turns up again, delete it rather than ignore it.

# Generated card thumbnails — npm run build:thumbnails
public/atlas/thumb/
